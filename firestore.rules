rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the caller is an authenticated admin
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Helper function to validate 6-character alphanumeric ID
    function isValidSubtopicId(id) {
      return id is string && id.matches('^[0-9a-zA-Z]{6}$');
    }

    // Meta collection (denormalized topic tree, global counters)
    match /meta/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Topics collection
    match /topics/{topicId} {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.data.name is string
        && request.resource.data.slug is string
        && (request.resource.data.parentId == null || isValidSubtopicId(request.resource.data.parentId) || request.resource.data.parentId is string)
        && request.resource.data.level is int
        && request.resource.data.level >= 0
        && request.resource.data.ancestors is list
        && request.resource.data.blogCount is int;
    }

    // Subtopic ID reservation collection for transactional collision safety
    match /subtopic_ids/{id} {
      allow read: if true;
      allow write: if isAdmin() && isValidSubtopicId(id);
    }

    // Blogs collection
    match /blogs/{blogId} {
      // Public can only read published blogs; admins can read drafts
      allow read: if resource.data.status == 'published' || isAdmin();
      
      // Only admins can create, update, or delete blogs
      allow write: if isAdmin()
        && request.resource.data.title is string
        && request.resource.data.slug is string
        && isValidSubtopicId(request.resource.data.subtopicId)
        && request.resource.data.topicPath is list
        && request.resource.data.status in ['draft', 'published']
        && request.resource.data.blocks is list;

      // Subcollection for blocks if blog size exceeds threshold
      match /blocks/{blockId} {
        allow read: if get(/databases/$(database)/documents/blogs/$(blogId)).data.status == 'published' || isAdmin();
        allow write: if isAdmin();
      }
    }
  }
}
